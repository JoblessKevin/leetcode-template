{
    "editor.formatOnSave": true,

    // Java
    "java.project.sourcePaths": [
        "java/src/main/java"
    ],
    "java.import.gradle.enabled": true,
    "java.format.settings.url": ".vscode/aosp-java-google-style.xml",
    "[java]": {
        "editor.defaultFormatter": "redhat.java"
    },

    // Python
    "python.defaultInterpreterPath": "${workspaceFolder}/python/.venv/Scripts/python.exe",
    "python.testing.pytestEnabled": true,
    "python.testing.cwd": "${workspaceFolder}/python",
    "python.testing.pytestArgs": ["."],
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff"
    },

    // C++
    "cmake.sourceDirectory": "${workspaceFolder}/cpp",
    "cmake.buildDirectory": "${workspaceFolder}/cpp/build",
    "clangd.arguments": ["--compile-commands-dir=${workspaceFolder}/cpp/build"],
    "[cpp]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    }
}
