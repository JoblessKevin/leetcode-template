{
    "editor.formatOnSave": true,

    // Java
    "java.project.sourcePaths": [
        "java/src/main/java"
    ],
    "java.import.gradle.enabled": true,
    "java.format.settings.url": ".vscode/aosp-java-google-style.xml",
    "[java]": {
        "editor.defaultFormatter": "redhat.java"
    },

    // Python (interpreter path is OS-specific: pick python/.venv via "Python: Select Interpreter";
    // Codespaces sets it in .devcontainer/devcontainer.json)
    "python.testing.pytestEnabled": true,
    "python.testing.cwd": "${workspaceFolder}/python",
    "python.testing.pytestArgs": ["."],
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff"
    },

    // C++
    "cmake.sourceDirectory": "${workspaceFolder}/cpp",
    "cmake.buildDirectory": "${workspaceFolder}/cpp/build",
    "clangd.arguments": [
        "--compile-commands-dir=${workspaceFolder}/cpp/build",
        // Let clangd ask g++ (MinGW on Windows, GCC in Codespaces) for its standard header paths
        "--query-driver=**/g++*"
    ],
    "[cpp]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    }
}
